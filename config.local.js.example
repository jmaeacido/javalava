// Copy to config.local.js for Laragon/local static hosting (gitignored).
// Used when static HTML is served by Apache and the Node API runs separately.
window.JavaLavaConfig = Object.assign({}, window.JavaLavaConfig, {
  // Node backend (npm run dev:api) when static HTML is served from Laragon:
  apiBase: 'http://localhost:3000',
  googleMapsApiKey: 'your-google-maps-browser-key'
});
