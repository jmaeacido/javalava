Options -MultiViews
RedirectMatch 301 ^/java-lava/site/concept-a/?(.*)$ /java-lava/$1
RewriteEngine On

# Concept A is now the primary site at /java-lava/.

# Custom branded 404 page
ErrorDocument 404 /java-lava/404.html

# Redirect explicit /index.html requests to the directory URL.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Redirect explicit .html requests to extensionless URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[?\s] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Serve matching .html files for extensionless URLs.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
